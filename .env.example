# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# A YouTube Data API v3 key, used only by scripts/build-tracks.mjs on your own
# machine. The deployed site never sees it — it reads data/tracks.json and
# nothing else.
#
# Get one: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Enable "YouTube Data API v3", then Credentials -> Create credentials -> API key.

YT_API_KEY=
